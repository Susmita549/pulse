generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  customers Customer[]
  waves     Wave[]
}

model Customer {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  phone     String
  createdAt DateTime @default(now())

  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  responses Response[]

  @@unique([brandId, phone])
  @@index([brandId])
}

model Wave {
  id        String   @id @default(cuid())
  brandId   String
  label     String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  brand     Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  responses Response[]

  @@unique([brandId, label])
  @@index([brandId])
}

model Response {
  id          String   @id @default(cuid())
  waveId      String
  customerId  String
  score       Int
  verbatim    String?
  /// Provider-supplied de-duplication key. Null for responses captured in-app.
  eventId     String?  @unique
  respondedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  wave     Wave     @relation(fields: [waveId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}
